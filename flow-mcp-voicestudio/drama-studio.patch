+  detail(slug: string) {
+    const d = this.load(slug);
+    return { ...this.summary(d), brief: d.brief, script: d.script, cast: d.cast, lines: d.lines, frames: d.frames, shots: d.shots, sounds: d.sounds, music: d.music };
+  }
+
+  // Starts the stages in the background and returns at once; flow_drama_status (or the panel) follows along.
+  start(slug: string, stages: readonly Stage[] = STAGES, confirm: { usd?: number; flow_credits?: boolean } = {}) {
+    const d = this.load(slug);
+    if (this.live.has(d.slug)) throw new Error("This drama is already being made.");
+    const q = this.quote(d, stages);
+    // Spending needs the user's yes: money up to an amount they approved, and Flow credits by an explicit OK.
+    const usd = confirm.usd ?? 0;
+    if (q.usd > 0.005 && usd + 0.005 < q.usd) {
+      throw new Error(`This run would cost about $${q.usd.toFixed(2)} (${q.lines.join("; ")}). Ask the user, then run again with confirm_spend_usd of at least ${q.usd.toFixed(2)}`);
+    }
+    if (q.flow_credits > 0 && !confirm.flow_credits) {
+      throw new Error(`This run would use up to ${q.flow_credits} Flow credits (${q.lines.join("; ")}). Ask the user, then run again with confirm_flow_credits: true.`);
+    }
+    d.approved_usd = d.spent_usd + Math.max(usd, q.usd);
+    this.save(d);
+    const job = this.pipeline(d.slug, stages).finally(() => this.live.delete(d.slug));
+    this.live.set(d.slug, job);
+    return { started: true, stages, quote: q, follow: "flow_drama_status shows progress; nothing else needs calling while it runs." };
+  }
+
+  busy = (slug: string) => this.live.has(slugOf(slug));
+
+  private async pipeline(slug: string, stages: readonly Stage[]) {
+    for (const stage of STAGES) {
+      if (!stages.includes(stage)) continue;
+      const d = this.load(slug);
+      d.running = { stage, since: new Date().toISOString() };
+      this.note(d, `${stage}: started`);
+      try {
+        await this[stage](slug);
+        const after = this.load(slug);
+        this.note(after, `${stage}: finished`);
+      } catch (err) {
+        const after = this.load(slug);
+        after.running = undefined;
+        this.note(after, `${stage}: stopped - ${err instanceof Error ? err.message : String(err)}`);
+        return;
+      }
+    }
+    const d = this.load(slug);
+    d.running = undefined;
+    this.note(d, "all done");
+  }
+
+  // Runs one item, records success or the reason it failed, and keeps going with the rest.
+  private async each<T extends Item | Line>(slug: string, pick: (d: Drama) => T[], label: (i: number) => string, make: (d: Drama, i: number) => Promise<Partial<T>>) {
+    const total = pick(this.load(slug)).length;
+    let failed = 0;
+    for (let i = 0; i < total; i++) {
+      let d = this.load(slug);
+      if (pick(d)[i].status === "done") continue;
+      d.running = { ...d.running!, item: label(i) };
+      Object.assign(pick(d)[i], { status: "running", error: undefined });
+      this.save(d);
+      try {
+        const out = await make(d, i);
+        d = this.load(slug);
+        Object.assign(pick(d)[i], out, { status: "done", error: undefined });
+        const cost = (out as Item).cost_usd ?? 0;
+        d.spent_usd += cost;
+        d.spent_credits += (out as Item).credits ?? 0;
+        this.note(d, `${label(i)} done${cost ? ` (~$${cost.toFixed(2)})` : ""}`);
+        if (d.spent_usd > d.approved_usd + 0.5) throw new Error(`Spending reached $${d.spent_usd.toFixed(2)}, past the $${d.approved_usd.toFixed(2)} you approved. Stopped to be safe.`);
+      } catch (err) {
+        failed++;
+        d = this.load(slug);
+        Object.assign(pick(d)[i], { status: "failed", error: err instanceof Error ? err.message : String(err) });
+        this.note(d, `${label(i)} failed: ${pick(d)[i].error}`);
+        if (/past the .* you approved|No .* key yet|didn't accept|isn't running/i.test(String(pick(d)[i].error))) throw err;
+      }
+    }
+    if (failed) throw new Error(`${failed} item(s) failed - see errors; fix or redo them and run again.`);
+  }
+
+  private async write(slug: string) {
+    const d = this.load(slug);
+    if (d.script) return;
+    if (d.providers.writer.id === "chat") throw new Error("Waiting for the script: ask Claude in chat to write it (flow_drama_script).");
+    const s = await writeScript(d.providers.writer.id, d.providers.writer.model, d.brief);
+    const after = this.load(slug);
+    this.adopt(after, s);
+    after.spent_usd += this.quote({ ...after, script: undefined }, ["write"]).usd;
+    this.note(after, `script written: ${s.scenes.length} shots, ${s.characters.length} characters`);
+  }
+
+  private names = (d: Drama) => d.script!.characters.map((c) => c.name);
+
+  private async cast(slug: string) {
+    const names = this.names(this.load(slug));
