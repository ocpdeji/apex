+import { execFile } from "node:child_process";
+import { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { promisify } from "node:util";
+import { assemble, voiceTrack } from "../assemble.js";
+import { burnCaptions, captionedName } from "../captions.js";
+import { clean, writeScript, type Brief, type Script, type Writer } from "./script.js";
+import {
+  IMAGE_PROVIDERS,
+  VIDEO_PROVIDERS,
+  VOICE_PROVIDERS,
+  estimate,
+  makeImage,
+  makeMusic,
+  makeSound,
+  makeVideo,
+  pickVoices,
+  speakLine,
+  type ImageProvider,
+  type VideoProvider,
+  type VoiceChoice,
+  type VoiceProvider,
+} from "./providers.js";
+
+const run = promisify(execFile);
+const FFPROBE = process.env.FLOW_MCP_FFPROBE ?? "ffprobe";
+
+// What Flow itself does for the studio. LocalCore supplies it, so Flow's own queue, pacing and credit guard still
+// decide every Flow generation; the studio only waits for the result.
+export interface FlowBridge {
+  image(prompt: string, refs: string[], out_dir: string, stem: string): Promise<string>;
+  video(prompt: string, first_frame: string, seconds: number, model: string | undefined, max_credits: number, out_dir: string, stem: string): Promise<{ file: string; credits?: number }>;
+  character(name: string, look: string): Promise<{ asset: string; portrait?: string }>;
+}
+
+export const STAGES = ["write", "cast", "voices", "frames", "shots", "sound", "cut"] as const;
+export type Stage = (typeof STAGES)[number];
+
+type ItemStatus = "todo" | "running" | "done" | "failed";
+interface Item {
+  status: ItemStatus;
+  file?: string;
+  error?: string;
+  cost_usd?: number;
+  credits?: number;
+}
+export interface Line {
+  scene: number;
+  character: string;
+  text: string;
+  emotion: string;
+  file?: string;
+  seconds?: number;
+  status: ItemStatus;
+  error?: string;
+}
+
+export interface Providers {
+  writer: { id: Writer; model?: string };
+  image: { id: ImageProvider; model?: string };
+  video: { id: VideoProvider; model?: string };
+  voice: { id: VoiceProvider; model?: string };
+  music: { id: "none" | "elevenlabs" | "file"; file?: string };
+  sound_effects: boolean;
+}
+
+export interface Options {
+  captions: boolean;
+  caption_style: "bold" | "highlight" | "reveal" | "clean" | "boxed";
+  max_credits: number;
+  clip_volume: number;
+  music_volume: number;
+}
+
+export interface Drama {
+  slug: string;
+  dir: string;
+  created: string;
+  updated: string;
+  brief: Brief;
+  providers: Providers;
+  options: Options;
+  script?: Script;
+  cast: Record<string, Item & { asset?: string; voice?: VoiceChoice }>;
+  lines: Line[];
+  frames: Item[];
+  shots: Item[];
+  sounds: Item[];
+  music?: Item;
+  final?: Item & { captioned?: string };
+  approved_usd: number;
+  spent_usd: number;
+  spent_credits: number;
+  running?: { stage: Stage; item?: string; since: string };
+  log: string[];
+}
+
+export const slugOf = (title: string) => title.trim().replace(/[^\w.-]+/g, "_").replace(/^_+|_+$/g, "").slice(0, 60) || "Untitled";
+
+export class Studio {
+  private live = new Map<string, Promise<void>>();
+
+  constructor(
+    private root: string,
+    private flow: FlowBridge,
+  ) {}
+
+  private file = (slug: string) => join(this.root, slug, "drama.json");
+
+  list() {
+    if (!existsSync(this.root)) return [];
+    return readdirSync(this.root, { withFileTypes: true })
+      .filter((d) => d.isDirectory() && existsSync(this.file(d.name)))
+      .map((d) => this.summary(this.load(d.name)))
+      .sort((a, b) => b.updated.localeCompare(a.updated));
+  }
+
+  load(slug: string): Drama {
+    const f = this.file(slugOf(slug));
+    if (!existsSync(f)) throw new Error(`There's no drama called "${slug}". flow_drama_list shows them all.`);
+    return JSON.parse(readFileSync(f, "utf8")) as Drama;
+  }
+
+  private save(d: Drama) {
+    d.updated = new Date().toISOString();
+    mkdirSync(d.dir, { recursive: true });
+    const tmp = this.file(d.slug) + ".tmp";
+    writeFileSync(tmp, JSON.stringify(d, null, 2));
+    renameSync(tmp, this.file(d.slug));
+  }
+
+  private note(d: Drama, msg: string) {
+    d.log = [...d.log, `${new Date().toISOString().slice(11, 19)} ${msg}`].slice(-200);
+    this.save(d);
+  }
+
+  create(a: { brief: Brief; providers?: Partial<Providers>; options?: Partial<Options>; script?: Script; replace?: boolean }): Drama {
+    const slug = slugOf(a.brief.title);
+    if (existsSync(this.file(slug)) && !a.replace) throw new Error(`A drama called "${a.brief.title}" already exists. Open it, or pass replace: true to start over.`);
+    const now = new Date().toISOString();
+    const d: Drama = {
+      slug,
+      dir: join(this.root, slug),
+      created: now,
+      updated: now,
+      brief: a.brief,
+      providers: {
+        writer: a.providers?.writer ?? { id: a.script ? "chat" : "anthropic" },
+        image: a.providers?.image ?? { id: "flow" },
+        video: a.providers?.video ?? { id: "flow" },
+        voice: a.providers?.voice ?? { id: "gemini" },
+        music: a.providers?.music ?? { id: "none" },
+        sound_effects: a.providers?.sound_effects ?? false,
+      },
+      options: { captions: true, caption_style: "bold", max_credits: 25, clip_volume: 0.35, music_volume: 0.18, ...a.options },
+      cast: {},
+      lines: [],
+      frames: [],
+      shots: [],
+      sounds: [],
+      approved_usd: 0,
+      spent_usd: 0,
+      spent_credits: 0,
+      log: [],
+    };
+    if (a.script) this.adopt(d, clean(a.script, a.brief));
+    this.save(d);
+    return d;
+  }
+
+  // A new or edited script resets whatever was made from it: shots of a rewritten scene would no longer match.
+  private adopt(d: Drama, s: Script, keepCast = false) {
+    const old = d.cast;
+    d.script = s;
+    d.cast = Object.fromEntries(s.characters.map((c) => [c.name, keepCast && old[c.name] ? old[c.name] : { status: "todo" as ItemStatus }]));
+    d.lines = s.scenes.flatMap((sc, i) => [
+      ...sc.dialogue.map((l) => ({ scene: i, character: l.character, text: l.line, emotion: l.emotion, status: "todo" as ItemStatus })),
+      ...(sc.narration ? [{ scene: i, character: "Narrator", text: sc.narration, emotion: "calm", status: "todo" as ItemStatus }] : []),
+    ]);
+    d.frames = s.scenes.map(() => ({ status: "todo" }));
+    d.shots = s.scenes.map(() => ({ status: "todo" }));
+    d.sounds = s.scenes.map(() => ({ status: "todo" }));
+    d.final = undefined;
+  }
+
+  setScript(slug: string, script: Script, keepCast = true) {
+    const d = this.load(slug);
+    if (this.live.has(d.slug)) throw new Error("This drama is being made right now. Wait for it to finish, then edit the script.");
+    this.adopt(d, clean(script, d.brief), keepCast);
+    this.note(d, "script replaced");
+    return this.summary(d);
+  }
+
+  configure(slug: string, a: { providers?: Partial<Providers>; options?: Partial<Options>; voices?: Record<string, VoiceChoice> }) {
+    const d = this.load(slug);
+    if (this.live.has(d.slug)) throw new Error("This drama is being made right now. Change settings once it has finished.");
+    // Only what was actually given changes; a setting left out keeps its value.
+    const given = <T extends object>(o?: T) => Object.fromEntries(Object.entries(o ?? {}).filter(([, v]) => v !== undefined)) as Partial<T>;
+    d.providers = { ...d.providers, ...given(a.providers) };
+    d.options = { ...d.options, ...given(a.options) };
+    for (const [name, v] of Object.entries(a.voices ?? {})) {
+      if (!d.cast[name]) throw new Error(`No character called "${name}".`);
+      d.cast[name].voice = v;
+      // A new voice means every line of that character is recorded again.
+      for (const l of d.lines) if (l.character === name) l.status = "todo";
+    }
+    this.save(d);
+    return this.summary(d);
+  }
+
+  // Marks one thing to be made again on the next run, optionally with a new prompt or line.
+  redo(slug: string, a: { what: "portrait" | "line" | "frame" | "shot" | "sound" | "music" | "final"; scene?: number; character?: string; index?: number; prompt?: string; motion?: string; text?: string }) {
+    const d = this.load(slug);
+    if (this.live.has(d.slug)) throw new Error("This drama is being made right now. Redo things once it has finished.");
+    const s = d.script;
+    if (!s) throw new Error("There's no script yet.");
+    const sc = a.scene !== undefined ? a.scene - 1 : -1;
+    const scene = () => {
+      if (sc < 0 || sc >= s.scenes.length) throw new Error(`Scene must be 1 to ${s.scenes.length}.`);
+      return s.scenes[sc];
+    };
+    if (a.what === "portrait") {
+      const c = s.characters.find((x) => x.name.toLowerCase() === (a.character ?? "").toLowerCase());
