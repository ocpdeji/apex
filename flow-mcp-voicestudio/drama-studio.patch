+        ...d.frames.flatMap((f, i) => (f.error ? [`frame ${i + 1}: ${f.error}`] : [])),
+        ...d.shots.flatMap((f, i) => (f.error ? [`shot ${i + 1}: ${f.error}`] : [])),
+        ...d.sounds.flatMap((f, i) => (f.error ? [`sound ${i + 1}: ${f.error}`] : [])),
+        ...(d.final?.error ? [`final: ${d.final.error}`] : []),
