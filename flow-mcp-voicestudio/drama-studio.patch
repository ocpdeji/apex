new file mode 100644
index 0000000..543492a
--- /dev/null
+++ b/src/drama/keys.ts
@@ -0,0 +1,79 @@
+import { chmodSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { HOME_DIR } from "../chrome.js";
+import { geminiKey, saveGeminiKey } from "../gemini.js";
+
+// Every paid service the Drama Studio can use, with where its key comes from. Keys are typed into the Flow Studio panel
+// only and saved in a file only this user can read; no MCP tool can read or write them, so a key never enters a chat.
+// An environment variable of the usual name works too and wins over the file.
+export const KEY_SPECS = {
+  anthropic: { label: "Anthropic (Claude)", env: "ANTHROPIC_API_KEY", url: "https://console.anthropic.com/settings/keys", used_for: "writing" },
+  openai: { label: "OpenAI", env: "OPENAI_API_KEY", url: "https://platform.openai.com/api-keys", used_for: "writing, images, voices" },
+  gemini: { label: "Google AI Studio (Gemini, Veo)", env: "GEMINI_API_KEY", url: "https://aistudio.google.com/apikey", used_for: "writing, images, video, voices" },
+  fal: { label: "fal.ai", env: "FAL_KEY", url: "https://fal.ai/dashboard/keys", used_for: "images, video (Kling, Hailuo, Seedance, Wan, Veo)" },
+  openrouter: { label: "OpenRouter", env: "OPENROUTER_API_KEY", url: "https://openrouter.ai/settings/keys", used_for: "images" },
+  runway: { label: "Runway", env: "RUNWAYML_API_SECRET", url: "https://dev.runwayml.com/", used_for: "video" },
+  kling: { label: "Kling API key", env: "KLING_API_KEY", url: "https://app.klingai.com/global/dev/api-key", used_for: "video" },
+  kling_access: { label: "Kling access key (older accounts)", env: "KLING_ACCESS_KEY", url: "https://app.klingai.com/global/dev/api-key", used_for: "video" },
+  kling_secret: { label: "Kling secret key (older accounts)", env: "KLING_SECRET_KEY", url: "https://app.klingai.com/global/dev/api-key", used_for: "video" },
+  higgsfield_key: { label: "Higgsfield API key", env: "HIGGSFIELD_API_KEY", url: "https://console.higgsfield.ai/", used_for: "video" },
+  higgsfield_secret: { label: "Higgsfield API secret", env: "HIGGSFIELD_API_SECRET", url: "https://console.higgsfield.ai/", used_for: "video" },
+  elevenlabs: { label: "ElevenLabs", env: "ELEVENLABS_API_KEY", url: "https://elevenlabs.io/app/settings/api-keys", used_for: "voices, sound effects, music" },
+} as const;
+export type KeyName = keyof typeof KEY_SPECS;
+
+const FILE = join(HOME_DIR, "keys.json");
+
+function stored(): Partial<Record<KeyName, string>> {
+  try {
+    return existsSync(FILE) ? (JSON.parse(readFileSync(FILE, "utf8")) as Partial<Record<KeyName, string>>) : {};
+  } catch {
+    return {};
+  }
+}
+
+export function key(name: KeyName): string | undefined {
+  if (name === "gemini") return geminiKey();
+  const v = (process.env[KEY_SPECS[name].env] ?? stored()[name] ?? "").trim();
+  return v.length >= 8 ? v : undefined;
+}
+
+export function need(name: KeyName): string {
+  const k = key(name);
+  if (!k) {
+    const s = KEY_SPECS[name];
+    throw new Error(`No ${s.label} key yet. Get one at ${s.url}, then paste it into Flow Studio → Drama → Keys → ${s.label} → Save. Never paste keys into a chat.`);
+  }
+  return k;
+}
+
+// What the panel and Claude may see: which keys exist and their last four characters, never the keys.
+export function keyStatus() {
+  return Object.fromEntries(
+    (Object.keys(KEY_SPECS) as KeyName[]).map((n) => {
+      const k = key(n);
+      const from = !k ? undefined : n === "gemini" ? "saved" : process.env[KEY_SPECS[n].env] ? "environment" : "saved";
+      return [n, { ...KEY_SPECS[n], set: Boolean(k), ending: k?.slice(-4), from }];
+    }),
+  );
+}
+
+// Panel only. An empty value removes a saved key. Gemini keeps its own checked-with-Google file, shared with Voice.
+export async function saveKey(name: KeyName, raw: string) {
+  if (!(name in KEY_SPECS)) throw new Error(`Unknown key "${name}".`);
+  const value = raw.trim();
+  if (name === "gemini") {
+    if (!value) throw new Error("Paste the Google AI Studio key first.");
+    return saveGeminiKey(value);
+  }
+  if (value && (!/^[\x21-\x7e]{8,512}$/.test(value) || /^(YOUR|PASTE|<|\$)/i.test(value))) {
+    throw new Error(`That doesn't look like a ${KEY_SPECS[name].label} key. Copy the whole key, with no spaces.`);
+  }
+  const all = stored();
+  if (value) all[name] = value;
+  else delete all[name];
+  mkdirSync(dirname(FILE), { recursive: true });
+  writeFileSync(FILE, JSON.stringify(all, null, 2), { mode: 0o600 });
+  chmodSync(FILE, 0o600);
+  return { saved: Boolean(value), name, ending: value ? value.slice(-4) : undefined };
+}
diff --git a/src/drama/providers.ts b/src/drama/providers.ts
new file mode 100644
index 0000000..ed164d6
--- /dev/null
+++ b/src/drama/providers.ts
@@ -0,0 +1,63 @@
+import { key, type KeyName } from "./keys.js";
+import { IMAGE_PROVIDERS, imagePrice, makeImage, type ImageProvider } from "./images.js";
+import { VIDEO_PROVIDERS, videoPrice, makeVideo, type VideoProvider } from "./video.js";
+import { VOICE_PRICE, VOICE_PROVIDERS, makeMusic, makeSound, pickVoices, speakLine, type VoiceChoice, type VoiceProvider } from "./audio.js";
+import type { Writer } from "./script.js";
+
+export { IMAGE_PROVIDERS, VIDEO_PROVIDERS, VOICE_PROVIDERS, makeImage, makeVideo, makeMusic, makeSound, pickVoices, speakLine };
+export type { ImageProvider, VideoProvider, VoiceProvider, VoiceChoice };
+
+const ready = (keys: readonly string[]) => keys.every((k) => Boolean(key(k as KeyName)));
+
+// Everything the panel's pickers and flow_drama_providers show, with whether this computer has the keys for it.
+export function catalog() {
+  const tag = <T extends { keys: readonly string[]; available?: false }>(table: Record<string, T>) =>
+    Object.fromEntries(Object.entries(table).map(([id, p]) => [id, { ...p, ready: p.available !== false && (id === "kling" ? Boolean(key("kling") || (key("kling_access") && key("kling_secret"))) : ready(p.keys)) }]));
+  return { image: tag(IMAGE_PROVIDERS), video: tag(VIDEO_PROVIDERS), voice: tag(VOICE_PROVIDERS) };
+}
+
+// Writing an episode is one long request: a rough price per writer.
+const WRITER_USD: Record<Writer, number> = { anthropic: 0.25, openai: 0.3, gemini: 0.1, chat: 0 };
+
+export function estimate(a: {
+  writer?: Writer;
+  image: { id: ImageProvider; model?: string };
+  images: number;
+  video: { id: VideoProvider; model?: string };
+  shot_seconds: number;
+  shots: number;
+  voice: { id: VoiceProvider };
+  voice_chars: number;
+  sounds: number;
+  music: number;
+  max_credits: number;
+}) {
+  const lines: string[] = [];
+  let usd = 0;
+  let flow_credits = 0;
+  const add = (what: string, cost: number) => {
+    if (cost > 0.001) {
+      usd += cost;
+      lines.push(`${what} ~$${cost.toFixed(2)}`);
+    }
+  };
+  if (a.writer) add("script", WRITER_USD[a.writer]);
+  if (a.images) {
+    if (a.image.id === "flow") lines.push(`${a.images} image(s) on Flow, free`);
+    else add(`${a.images} image(s) on ${IMAGE_PROVIDERS[a.image.id].label}`, a.images * imagePrice(a.image.id, a.image.model));
+  }
+  if (a.shots) {
+    if (a.video.id === "flow") {
+      flow_credits = a.shots * a.max_credits;
+      lines.push(`${a.shots} shot(s) on Flow, at most ${a.max_credits} credits each (usually 7-15)`);
+    } else add(`${a.shots} shot(s), ${a.shot_seconds} s on ${VIDEO_PROVIDERS[a.video.id].label}`, videoPrice(a.video.id, a.video.model, a.shot_seconds, a.shots));
+  }
+  if (a.voice_chars) {
+    const cost = (a.voice_chars / 1000) * VOICE_PRICE[a.voice.id];
+    if (cost > 0.001) add(`voices on ${VOICE_PROVIDERS[a.voice.id].label}`, cost);
+    else lines.push(`voices on ${VOICE_PROVIDERS[a.voice.id].label}, free`);
+  }
+  if (a.sounds) add(`${a.sounds} sound effect(s) on ElevenLabs`, a.sounds * 0.05);
+  if (a.music) add("music on ElevenLabs", 0.8);
+  return { usd: Number(usd.toFixed(2)), flow_credits, lines, note: "Estimates from each service's list prices; your plan's real price may differ." };
+}
diff --git a/src/drama/script.ts b/src/drama/script.ts
