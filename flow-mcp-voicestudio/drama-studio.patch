+  // Flow's part of the Drama Studio: its images, characters and shots go through the same queue, pacing and credit
+  // guard as everything else, and the studio only waits for them.
+  private bridge: FlowBridge = {
+    image: async (prompt, refs, out_dir, stem) => {
+      const job = this.queue.add({ prompt, type: "image", max_credits: 0, aspect_ratio: "9:16", reference_images: refs.length ? refs : undefined, output_dir: out_dir, file_stem: stem });
+      const done = await this.finish(job.id);
+      const file = done.files.find((f) => /\.(png|jpe?g|webp)$/i.test(f));
+      if (!file) throw new Error("Flow finished but no image came back.");
+      return file;
+    },
+    video: async (prompt, first_frame, seconds, model, max_credits, out_dir, stem) => {
+      const duration = ([4, 6, 8, 10] as const).find((x) => x >= seconds) ?? 10;
+      const job = this.queue.add({ prompt, type: "video", max_credits, aspect_ratio: "9:16", duration, model: model ?? "Omni 1.1 Flash", first_frame, output_dir: out_dir, file_stem: stem });
