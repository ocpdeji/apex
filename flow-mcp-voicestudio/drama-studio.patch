+      const chosen = await pickVoices(d.providers.voice.id, [...missing, ...(narrated && !d.cast.Narrator?.voice ? [{ name: "Narrator", voice: "calm, warm, middle-aged storyteller" }] : [])], d.brief.title, s.language);
