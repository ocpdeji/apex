+      rememberCharacter(name, look);
+      return { asset: `asset:${name}`, portrait: made.portrait };
+    },
+  };
+
+  private async finish(id: string): Promise<Job> {
+    for (;;) {
+      const job = this.queue.get(id);
+      if (!job) throw new Error("The Flow job disappeared.");
+      if (job.status === "done") return job;
+      if (job.status === "failed" || job.status === "cancelled") throw new Error(job.error ?? `Flow job ${job.status}.`);
+      await new Promise((r) => setTimeout(r, 3000));
+    }
+  }
