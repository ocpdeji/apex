+    await this.each(slug, pick, (i) => `portrait of ${names[i]}`, async (d, i) => {
+      const c = d.script!.characters[i];
+      const look = `${d.script!.visual_style.trim().replace(/[.\s]*$/, "")}. Character reference sheet portrait of ${c.name}, ${c.role}: ${c.look}. Full figure and clear face, neutral plain background, even light, no text.`;
+      const dir = join(d.dir, "cast");
+      mkdirSync(dir, { recursive: true });
+      if (d.providers.image.id === "flow") {
+        const made = await this.flow.character(`${c.name} - ${d.slug}`.slice(0, 60), look);
+        const file = made.portrait ? copyInto(made.portrait, dir, slugOf(c.name)) : undefined;
+        return { file, asset: made.asset };
+      }
+      const out = await makeImage(d.providers.image.id, d.providers.image.model, look, [], join(dir, slugOf(c.name)));
+      return { file: out.file, cost_usd: out.cost_usd };
+    });
+  }
+
+  private async voices(slug: string) {
+    let d = this.load(slug);
+    const s = d.script!;
+    // Each character keeps one voice for the whole episode; any not chosen by the user get a distinct match.
+    const missing = s.characters.filter((c) => !d.cast[c.name]?.voice || d.cast[c.name].voice!.provider !== d.providers.voice.id);
+    const narrated = d.lines.some((l) => l.character === "Narrator");
