+    });
+  }
+
+  private async frames(slug: string) {
+    await this.each(slug, (d) => d.frames, (i) => `frame ${i + 1}`, async (d, i) => {
+      const s = d.script!;
+      const sc = s.scenes[i];
+      const people = sc.characters.map((n) => s.characters.find((c) => c.name === n)).filter((c): c is Script["characters"][number] => Boolean(c));
+      const who = people.map((c) => `${c.name} is exactly: ${c.look}`).join(" ");
