+      writer: stages.includes("write") && !s ? d.providers.writer.id : undefined,
+      image: d.providers.image,
+      images: (stages.includes("cast") ? castCount : 0) + (stages.includes("frames") ? frameCount : 0),
+      video: d.providers.video,
