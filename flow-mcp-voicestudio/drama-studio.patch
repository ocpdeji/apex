+      dir: d.dir,
+      clips: t.scenes.map((x) => x.clip),
+      voiceover: voice?.file,
+      music,
+      music_volume: d.options.music_volume,
+      clip_volume: d.options.clip_volume,
+      output_name: `${d.slug}-episode`,
+      hold_last_frame: true,
+    });
