+    // characters, and some 14 characters of dialogue per second - so the first yes covers the whole run.
+    const secs = d.brief.seconds ?? 60;
+    const shotsGuess = d.brief.scenes ?? Math.max(3, Math.round(secs / 7));
+    const scenes = s?.scenes ?? [];
+    const shotCount = s ? todo(d.shots) : shotsGuess;
