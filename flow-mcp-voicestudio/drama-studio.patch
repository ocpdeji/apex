+
+// Where every shot starts in the film and where each line lands inside its shot.
+export function timeline(d: Drama) {
+  const s = d.script!;
+  let start = 0;
+  const lineAt: number[] = [];
+  const scenes = s.scenes.map((sc, i) => {
+    const mine = d.lines.map((l, j) => ({ l, j })).filter(({ l }) => l.scene === i);
+    let at = 0.3;
+    for (const { l, j } of mine) {
+      lineAt[j] = start + at;
+      at += (l.seconds ?? Math.ceil(l.text.split(/\s+/).length / 2.5)) + 0.2;
+    }
+    const speech = at - 0.2;
+    const clip = d.shots[i]?.file ?? "";
+    const length = clipSeconds.get(clip) ?? sc.seconds;
+    const out = { start, clip, length, speech };
+    start += length;
+    return out;
+  });
+  return { scenes, lineAt, total: start };
+}
+
+const clipSeconds = new Map<string, number>();
+async function seconds(file: string): Promise<number> {
+  const { stdout } = await run(FFPROBE, ["-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", file]);
+  const n = Number(stdout.trim()) || 0;
+  clipSeconds.set(file, n);
+  return n;
+}
+export async function measureShots(d: Drama) {
+  for (const s of d.shots) if (s.file && existsSync(s.file) && !clipSeconds.has(s.file)) await seconds(s.file);
+}
+
+function copyInto(src: string, dir: string, stem: string) {
+  const ext = src.match(/\.\w+$/)?.[0] ?? ".png";
+  const out = join(dir, stem + ext);
+  copyFileSync(src, out);
+  return out;
+}
