+    keys: ["kling"],
+    paid: true,
+    models: [m("kling-3.0", "Kling 3.0 · 720p", 0.084, { min: 3, max: 15 }), m("kling-4.0", "Kling 4.0 (not open on Kling's API yet)", 0.157, { min: 3, max: 30 })],
+    note: "Kling's own API with a Kling API key. Kling 4.0 is already available through fal.",
+  },
+  higgsfield: {
