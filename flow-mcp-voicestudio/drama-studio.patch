+    return {
+      title: d.brief.title,
+      slug: d.slug,
+      folder: d.dir,
+      updated: d.updated,
+      providers: d.providers,
+      options: d.options,
+      running: d.running ?? null,
+      written: Boolean(d.script),
+      progress: {
